[Unit]
Description=Gunicorn for Curtain Master
After=network.target

[Service]
User=django_user
Group=www-data
WorkingDirectory=/home/django_user/apps/uae_crtn
EnvironmentFile=/home/django_user/apps/uae_crtn/.env
ExecStart=/home/django_user/apps/uae_crtn/venv/bin/gunicorn \
          --workers 3 \
          --bind 127.0.0.1:8111 \
          curtain_master.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
